{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vronnblom/maths/schema/curriculum.schema.json",
  "title": "content/<subject>/curriculum.yml",
  "description": "The plan of a subject (docs/plan/02 §2.5). Checked by `scripts/graph.py check`, which adds the cross-entry rules (unique labels, prerequisites that resolve, no cycles, agreement with written pages).",
  "type": "object",
  "additionalProperties": false,
  "required": ["subject", "chapters"],
  "properties": {
    "subject": { "enum": ["calc", "linalg", "mvc", "found", "disc", "prob", "ana", "ode", "cplx"] },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "title", "topics"],
        "properties": {
          "slug": { "$ref": "#/$defs/slug" },
          "title": { "type": "string", "minLength": 1 },
          "topics": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/topic" } }
        }
      }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "label": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "topic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "file", "title", "level", "prerequisites", "objectives", "results"],
      "properties": {
        "label": { "$ref": "#/$defs/label" },
        "file": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*/[a-z0-9]+(-[a-z0-9]+)*\\.md$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 60 },
        "level": { "enum": ["core", "extension"] },
        "prerequisites": { "type": "array", "items": { "$ref": "#/$defs/label" }, "uniqueItems": true },
        "objectives": { "type": "array", "minItems": 2, "maxItems": 6, "items": { "type": "string", "minLength": 1 } },
        "widgets": { "type": "array", "items": { "$ref": "#/$defs/slug" }, "uniqueItems": true },
        "results": { "type": "array", "items": { "$ref": "#/$defs/result" } },
        "notes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {
        "label": { "type": "string", "pattern": "^(def|thm|lem|cor|prop|ax|eg|rem)-[a-z0-9]+(-[a-z0-9]+)+$" },
        "policy": { "type": "string", "pattern": "^[FRSD](\\+[FRSD])*$" },
        "deferred_to": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "minLength": 1 }
      }
    }
  }
}
